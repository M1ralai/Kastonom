{
  "name": "kastonom-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kastonom hackathon MVP backend orchestration API.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/pg-*.test.js",
    "test:all": "node --test tests/*.test.js",
    "db:migrate": "node src/db/migrate.js",
    "db:create": "node src/db/migrate.js create",
    "db:rollback": "node src/db/migrate.js rollback",
    "db:status": "node src/db/migrate.js status"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0"
  }
}
