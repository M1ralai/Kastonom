# ===========================================
# KASTONOM BACKEND - Environment Variables
# ===========================================
# Copy this file to .env and fill in values
# Production deployment requires all REQUIRED values to be set

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kastonom
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=30000
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY_MS=1000

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=3001

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=text

# ===========================================
# SECURITY - REQUIRED IN PRODUCTION
# ===========================================
# Allowed CORS origins (comma-separated, no spaces)
KASTONOM_ALLOWED_ORIGINS=http://localhost:5173
# Request body size limit in bytes (default: 1MB)
KASTONOM_BODY_LIMIT=1048576

# ===========================================
# JWT AUTHENTICATION - REQUIRED IN PRODUCTION
# ===========================================
JWT_SECRET=change-this-to-a-secure-secret-key-in-production-minimum-32-chars
# Access token expiry in seconds (default: 900 = 15 minutes)
KASTONOM_JWT_EXPIRY_SECONDS=900
# Refresh token expiry in days (default: 7)
KASTONOM_REFRESH_TOKEN_EXPIRY_DAYS=7

# ===========================================
# PASSWORD HASHING - REQUIRED IN PRODUCTION
# ===========================================
# bcrypt salt rounds (default: 12, increase for more security)
BCRYPT_SALT_ROUNDS=12
# Legacy salt - DO NOT CHANGE after initial deployment
# Required for migrating existing passwords
PASSWORD_SALT=kastonom-dev-salt-change-in-production

# ===========================================
# KASTONOM MODE
# ===========================================
KASTONOM_MODE=mock
KASTONOM_FALLBACK_ENABLED=true
KASTONOM_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
KASTONOM_DEFAULT_VIDEO_PROVIDER=mock
KASTONOM_DEFAULT_PLATFORM=generic_vertical
KASTONOM_DEFAULT_ASPECT_RATIO=9:16
KASTONOM_DEFAULT_LANGUAGE=Turkish
KASTONOM_DEFAULT_DURATION_SECONDS=15
KASTONOM_PUBLIC_BASE_URL=http://localhost:3001
# Optional: HTTPS base URL for uploaded reference images.
# For local live testing, point this at an HTTPS tunnel that forwards to the backend.
KASTONOM_PUBLIC_ASSET_BASE_URL=
KASTONOM_MOCK_PREVIEW_URL=/demo-assets/mock-ad-preview.mp4

# ===========================================
# POLLO VIDEO PROVIDER - REQUIRED FOR LIVE MODE
# ===========================================
# REQUIRED: Pollo API key from https://pollo.ai
POLLO_API_KEY=
# Optional: Custom API base URL
POLLO_API_BASE_URL=https://pollo.ai
# Optional: Timeout for video generation requests (milliseconds)
POLLO_TIMEOUT_MS=120000
# Optional: Webhook secret for receiving video completion events
POLLO_WEBHOOK_SECRET=

# ===========================================
# KLING VIDEO O1 THROUGH POLLO AI - REQUIRED WHEN KASTONOM_DEFAULT_VIDEO_PROVIDER=kling
# ===========================================
# Optional: If omitted, the backend reuses POLLO_API_KEY/POLLO_API_BASE_URL.
KLING_API_KEY=
KLING_API_BASE_URL=https://pollo.ai

# ===========================================
# AD PLATFORMS - REQUIRED FOR LIVE PUBLISHING
# ===========================================
# META_ADS_ACCOUNT_ID=
# META_ADS_ACCESS_TOKEN=

# GOOGLE_ADS_ACCOUNT_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
