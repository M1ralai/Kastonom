# Kastonom Go Backend environment
# Copy this file to .env or .env.local before running locally.

# Application
PORT=3001
KASTONOM_VERSION=0.1.0-go
KASTONOM_MODE=mock
KASTONOM_FALLBACK_ENABLED=true
KASTONOM_DEMO_TENANT_ID=demo-tenant
KASTONOM_PUBLIC_BASE_URL=http://localhost:3001

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kastonom?sslmode=disable
# POSTGRES_DSN can be used instead of DATABASE_URL.
POSTGRES_DSN=
DB_POOL_SIZE=20
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=1800

# Generation defaults
KASTONOM_DEFAULT_VIDEO_PROVIDER=mock
KASTONOM_DEFAULT_LANGUAGE=tr
KASTONOM_DEFAULT_PLATFORM=reels
KASTONOM_DEFAULT_DURATION_SECONDS=15
KASTONOM_DEFAULT_ASPECT_RATIO=9:16
KASTONOM_MOCK_PREVIEW_URL=/demo-assets/mock-ad-preview.mp4

# Future live provider credentials
POLLO_API_KEY=
POLLO_API_BASE_URL=https://pollo.ai
POLLO_TIMEOUT_MS=120000
POLLO_WEBHOOK_SECRET=
KLING_API_KEY=
KLING_API_BASE_URL=https://pollo.ai

# Future ad platform credentials
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
GOOGLE_ADS_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Upload directory served at GET /uploads/*
UPLOAD_DIR=./uploads
